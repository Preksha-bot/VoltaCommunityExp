{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"], "strict": true, "noEmit": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["node", "google-apps-script"]
  },
  "include": ["src", "tests", "scripts/**/*.ts", "*.config.ts"]
}
